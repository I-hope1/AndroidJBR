+// P2: errors that mean "the standard redefine path cannot express this change"
+// (structural edits: added/deleted methods, field layout, modifiers, hierarchy,
+// class attributes).  Everything else is a hard failure and must be reported
+// as-is instead of being retried through the enhanced path.
+static bool is_dcevm_structural_redefinition_error(jvmtiError e) {
+  switch ((int)e) {
+    case 63: // JVMTI_ERROR_UNSUPPORTED_REDEFINITION_METHOD_ADDED
+    case 64: // JVMTI_ERROR_UNSUPPORTED_REDEFINITION_SCHEMA_CHANGED
+    case 66: // JVMTI_ERROR_UNSUPPORTED_REDEFINITION_HIERARCHY_CHANGED
+    case 67: // JVMTI_ERROR_UNSUPPORTED_REDEFINITION_METHOD_DELETED
+    case 70: // JVMTI_ERROR_UNSUPPORTED_REDEFINITION_CLASS_MODIFIERS_CHANGED
+    case 71: // JVMTI_ERROR_UNSUPPORTED_REDEFINITION_METHOD_MODIFIERS_CHANGED
+    case 72: // JVMTI_ERROR_UNSUPPORTED_REDEFINITION_CLASS_ATTRIBUTE_CHANGED
+    case 79: // JVMTI_ERROR_UNMODIFIABLE_CLASS (enhanced is_modifiable_class is a superset)
+      return true;
+    default:
+      return false;
+  }
+}
+
+// P2: the standard path can only be used on classes that have no DCEVM version
+// chain.  After an enhanced (structural) redefine, the old Klass version is
+// still reachable for on-stack methods and keeps vtable entries that point at
+// the newer class; redefining the newer class through the standard path does
+// not repair those old-version vtables, and the mixed chain corrupts
+// vtableEntry::method() ownership (asserted by fastdebug's klassVtable::verify:
+// "method is from subclass").  Until the standard path learns to maintain the
+// DCEVM old-version vtables, fall back to the enhanced path whenever any
+// target class already has a DCEVM version chain.
+static bool standard_path_eligible(jint class_count, const jvmtiClassDefinition* class_definitions) {
+  for (int i = 0; i < class_count; i++) {
+    oop mirror = JNIHandles::resolve_non_null(class_definitions[i].klass);
+    Klass* k = java_lang_Class::as_Klass(mirror);
+    if (k == nullptr || !k->is_instance_klass()) {
+      return false;
+    }
+    InstanceKlass* ik = InstanceKlass::cast(k);
+    if (ik->old_version() != nullptr || ik->new_version() != nullptr) {
+      return false;
+    }
+  }
+  return true;
+}
