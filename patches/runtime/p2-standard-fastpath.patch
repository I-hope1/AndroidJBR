+// P2: ClassFileLoadHook output capture (see jvmtiThreadState.hpp).
+
+void JvmtiThreadState::cflh_capture_begin() {
+  cflh_capture_end();
+  _cflh_capture_names = new (mtInternal) GrowableArray<Symbol*>(8, mtInternal);
+  _cflh_capture_data  = new (mtInternal) GrowableArray<unsigned char*>(8, mtInternal);
+  _cflh_capture_lens  = new (mtInternal) GrowableArray<int>(8, mtInternal);
+  _cflh_capture_consume = false;
+}
+
+void JvmtiThreadState::cflh_capture_to_consume() {
+  _cflh_capture_consume = true;
+}
+
+void JvmtiThreadState::cflh_capture_end() {
+  if (_cflh_capture_names != nullptr) {
+    for (int i = 0; i < _cflh_capture_names->length(); i++) {
+      os::free(_cflh_capture_data->at(i));
+    }
+    delete _cflh_capture_names;
+    delete _cflh_capture_data;
+    delete _cflh_capture_lens;
+    _cflh_capture_names = nullptr;
+    _cflh_capture_data = nullptr;
+    _cflh_capture_lens = nullptr;
+  }
+  _cflh_capture_consume = false;
+}
+
+void JvmtiThreadState::cflh_capture_add(Symbol* name, const unsigned char* data, int len) {
+  if (_cflh_capture_names == nullptr || data == nullptr || len <= 0) {
+    return;
+  }
+  unsigned char* copy = (unsigned char*)os::malloc((size_t)len, mtInternal);
+  if (copy == nullptr) {
+    return;
+  }
+  memcpy(copy, data, (size_t)len);
+  _cflh_capture_names->append(name);
+  _cflh_capture_data->append(copy);
+  _cflh_capture_lens->append(len);
+}
+
+bool JvmtiThreadState::cflh_capture_find(Symbol* name, unsigned char** data, int* len) {
+  if (_cflh_capture_names == nullptr) {
+    return false;
+  }
+  for (int i = _cflh_capture_names->length() - 1; i >= 0; i--) {
+    if (_cflh_capture_names->at(i) == name) {
+      *data = _cflh_capture_data->at(i);
+      *len  = _cflh_capture_lens->at(i);
+      return true;
+    }
+  }
+  return false;
+}
+
 JvmtiThreadState::~JvmtiThreadState()   {
   assert(JvmtiThreadState_lock->is_locked(), "sanity check");
 
   if (_classes_being_redefined != nullptr) {
     delete _classes_being_redefined; // free the GrowableArray on C heap
   }
+  cflh_capture_end();
 
   // clear this as the state for the thread
   get_thread()->set_jvmti_thread_state(nullptr);
