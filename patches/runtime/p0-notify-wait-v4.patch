+  JavaThread* self = JavaThread::current();
+  if (self->thread_state() == _thread_in_native) {
+    // Called from JVMTI (native state): the safepoint-checked wait below requires
+    // VM state, and this also lets pending safepoints complete while we wait.
+    ThreadInVMfromNative tiv(self);
+    drainCompilationsForEnhancedRedefinition();
+  } else {
+    drainCompilationsForEnhancedRedefinition();
   }
