+// Wait for the compilations that are already running in the compiler threads.
+//
+// The old implementation slept on DcevmCompilation_lock (a nosafepoint rank
+// monitor) and executed VM_ForceSafepoint every 10ms. A JavaThread blocking in
+// VM state on a nosafepoint monitor prevents safepoints from completing, while a
+// compiler thread in native state only notices a pending safepoint when it
+// transitions to VM state (ciEnv::cache_jvmti_state, ciEnv::register_method,
+// ...). That is the "drain waits for compiler, compiler waits for safepoint,
+// safepoint waits for drain" deadlock which forced the periodic VM op.
+//
+// Waiting on a safepoint-checked monitor instead makes the drain thread
+// safepoint-safe: it is stopped at a safepoint like any other JavaThread, so
+// pending safepoints complete, compiler threads can make progress, and the wait
+// is notified as soon as the last in-flight compilation finishes.
+void CompileBroker::drainCompilationsForEnhancedRedefinition() {
+  assert(JavaThread::current()->thread_state() == _thread_in_vm, "must be in VM state");
+  MonitorLocker wait_ml(DcevmCompilationWait_lock);
+  while (Atomic::load(&_active_compilations) > 0) {
+    // During VM shutdown compiler threads are parked by maybe_block() and may
+    // never decrement _active_compilations. Don't hang a shutdown path that is
+    // calling into JVMTI (e.g. from a shutdown hook).
+    if (_should_block || VM_Exit::vm_exited()) {
+      return;
+    }
+    // The timeout is only a safety net (lost wakeup, compiler thread exiting
+    // unexpectedly); it is not the normal wakeup path.
+    wait_ml.wait(1000);
+  }
+}
