+// RAII guard for the "compilation stopped" window of an enhanced class
+// redefinition. The window is reference-counted, so concurrent enhanced
+// redefinitions share one stop period, and it is released even if the caller
+// returns early.
+class EnhancedClassRedefinitionCompilationStop : public StackObj {
+ public:
+  EnhancedClassRedefinitionCompilationStop()  {
+    CompileBroker::stopCompilationBeforeEnhancedRedefinition();
+  }
+  ~EnhancedClassRedefinitionCompilationStop() {
+    CompileBroker::releaseCompilationAfterEnhancedRedefinition();
+  }
+ private:
+  EnhancedClassRedefinitionCompilationStop(const EnhancedClassRedefinitionCompilationStop&);
+  void operator=(const EnhancedClassRedefinitionCompilationStop&);
 };
 
