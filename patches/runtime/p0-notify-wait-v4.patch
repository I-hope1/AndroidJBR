+// Serialize concurrent enhanced redefinitions.
+//
+// doit_prologue() runs on the calling JavaThread and loads the new class
+// versions, mutating global redefinition state (Klass flags, version chains,
+// affected-class sets). doit() then runs on the VM thread. Two enhanced
+// redefinitions interleaving in their prologues corrupt that state (for
+// example the topological class sorting asserts on Klass::MarkedAsAffected).
+// EnhancedRedefineClasses_lock exists for this purpose but is not usable from
+// the JVMTI entry points (rank/thread-state constraints), so serialize the
+// prologue..epilogue window on the standard RedefineClasses_lock instead.
+static int _enhanced_redefinitions_in_progress = 0;
+static JavaThread* _enhanced_redefine_owner = nullptr;
+
+static void release_enhanced_redefinition() {
+  MonitorLocker ml(RedefineClasses_lock);
+  assert(_enhanced_redefinitions_in_progress == 1, "unbalanced enhanced redefine");
+  assert(_enhanced_redefine_owner == JavaThread::current(), "released by non-owner");
+  _enhanced_redefinitions_in_progress = 0;
+  _enhanced_redefine_owner = nullptr;
+  ml.notify_all();
+}
